+# --- generator manifest + operation-identity (spec §6, §18.1) -------------
+
+EXPECTED_SPEC_COUNT = 41
+EXPECTED_OPERATION_COUNT = 455
+
+
+def test_enumerated_counts_match_snapshot() -> None:
+    services = load_all_services()
+    assert len(services) == EXPECTED_SPEC_COUNT
+    total = sum(len(list(iter_resolved_operations(s))) for s in services)
+    assert total == EXPECTED_OPERATION_COUNT
+
+
+def test_operation_identity_has_no_collisions() -> None:
+    # All 455 operations must enumerate to unique python + CLI names; this is the
+    # guard that replaced the renderer's old silent-skip behavior (spec §6.2).
+    services = load_all_services()
+    validate_operation_identity(services)  # raises on any collision
+
+
+def test_base_risk_classification() -> None:
+    assert base_risk("GET") == "read"
+    assert base_risk("HEAD") == "read"
+    assert base_risk("PUT") == "write"
+    assert base_risk("PATCH") == "write"
+    assert base_risk("DELETE") == "destructive"
+    assert base_risk("POST") == "unknown"
+
+
+def test_manifest_records_cover_every_operation() -> None:
+    services = load_all_services()
+    validate_operation_identity(services)
+    seen_keys: set[str] = set()
+    seen_cli_paths: set[tuple[str, ...]] = set()
+    for service in services:
+        svc_record = manifest_service(service)
+        assert len(svc_record["operations"]) == len(
+            list(iter_resolved_operations(service))
+        )
+        for operation in iter_resolved_operations(service):
+            record = manifest_operation(operation)
+            assert record["key"] not in seen_keys
+            seen_keys.add(record["key"])
+            path = tuple(record["cli_path"])
+            assert path not in seen_cli_paths
+            seen_cli_paths.add(path)
+    assert len(seen_keys) == EXPECTED_OPERATION_COUNT
